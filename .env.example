# ==============================================================================
# PRESENTON PRODUCTION CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI / LLM API Configuration (Bake API into codebase for all users)
# ------------------------------------------------------------------------------
# Choose your provider: "openrouter", "openai", "google", "anthropic", etc.
LLM=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o # e.g. openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# (Optional: OpenAI alternative)
# LLM=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Image Generation
IMAGE_PROVIDER=gpt-image-2
DISABLE_IMAGE_GENERATION=false

# ------------------------------------------------------------------------------
# 2. Clerk Authentication (Users sign in with Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 3. Supabase Database Configuration (PostgreSQL on Supabase)
# ------------------------------------------------------------------------------
# Replace with your Supabase database password and project reference
# Example: postgresql://postgres:YOUR_PASSWORD@db.hsudmspwseonzfdaldxj.supabase.co:5432/postgres
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://hsudmspwseonzfdaldxj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_S95sOi3C8gIS9u96HYSLSA_VAW-QYlF

# Automatically run database migrations on Supabase upon server startup
MIGRATE_DATABASE_ON_STARTUP=true
DISABLE_AUTH=false
